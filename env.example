# cp .env.example .env

# Gemini API key (used for LLM generation only — embeddings are local)
GOOGLE_API_KEY=your_gemini_api_key_here

# If you switch back to Gemini for generation, embeddings are already local so no change needed

# Ollama model name — change if you use a different local model
OLLAMA_MODEL=llama3.2:3b
